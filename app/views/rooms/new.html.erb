<h2><%= action_name == "new" ? "施設登録" : "施設編集" %></h2>

<%= form_with model: @room, local: true do |f| %>
  <% if @room.errors.any? %>
    <ul>
      <% @room.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
    </ul>
  <% end %>

  <div><%= f.label :name, "施設名" %><br><%= f.text_field :name, required: true %></div>
  <div><%= f.label :description, "施設詳細" %><br><%= f.text_area :description, required: true %></div>
  <div><%= f.label :price, "料金(/日)" %><br><%= f.number_field :price, min: 1, step: 1, required: true %></div>
  <div><%= f.label :address, "住所" %><br><%= f.text_field :address, required: true %></div>
  <div><%= f.label :image, "画像" %><br><%= f.file_field :image, accept: "image/*" %></div>

  <%= f.submit action_name == "new" ? "登録する" : "更新する" %>
<% end %>

<p><%= link_to "戻る", (request.referer || rooms_path) %></p>
