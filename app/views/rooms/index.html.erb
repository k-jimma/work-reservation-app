<h2>あなたの施設一覧</h2>
<p><%= link_to "新規登録", new_room_path %></p>
<% if @rooms.empty? %>
  <p>まだ施設がありません。</p>
<% else %>
  <ul>
    <% @rooms.each do |room| %>
      <li>
        <%= link_to room.name, room %>
        / ¥<%= number_with_delimiter(room.price) %>/日
        / <%= room.created_at.strftime("%Y/%m/%d") %>
      </li>
    <% end %>
  </ul>
<% end %>