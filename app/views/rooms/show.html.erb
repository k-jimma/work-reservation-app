<h2><%= @room.name %></h2>
<p>料金: ¥<%= number_with_delimiter(@room.price) %>/日</p>
<p>住所: <%= @room.address %></p>
<p><%= simple_format(@room.description) %></p>
<p><%= room_image_tag(@room, alt: @room.name) %></p>

<p>
  <%= link_to "戻る", (request.referer || rooms_path) %>
  <% if user_signed_in? && @room.user_id == current_user.id %>
    | <%= link_to "編集", edit_room_path(@room) %>
    | <%= link_to "削除", room_path(@room), data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか？" } %>
  <% end %>
</p>