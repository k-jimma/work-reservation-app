<h1>宿泊予約アプリ</h1>

<% if user_signed_in? %>
  <p>ようこそ、<%= current_user.name.presence || current_user.email %> さん！</p>
  <p><%= button_to "ログアウト", destroy_user_session_path, method: :delete %></p>
<% else %>
  <p><%= link_to "ログイン", new_user_session_path %> /
     <%= link_to "新規登録", new_user_registration_path %></p>
<% end %>

<hr>

<h2>新着の施設</h2>
<% if @rooms.blank? %>
  <p>まだ施設がありません。seedを流すか、後で作成画面を作って追加しましょう。</p>
<% else %>
  <ul>
    <% @rooms.each do |room| %>
      <li>
        <strong><%= room.name %></strong>
        / 料金: ¥<%= number_with_delimiter(room.price) %>/日
        / 住所: <%= room.address %>
        / 作成日: <%= room.created_at.strftime('%Y/%m/%d') %>
      </li>
    <% end %>
  </ul>
<% end %>
